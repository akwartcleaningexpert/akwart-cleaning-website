{"content":"<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Careers | A-Kwart Cleaning Expert Ltd</title>
    <meta
      name="description"
      content="Join the A-Kwart Cleaning Expert Ltd team. Apply for cleaning jobs and opportunities with our professional team."
    />
    <style>
      :root {
        --blue: #123b78;
        --blue-2: #1d4f97;
        --gold: #f4b942;
        --gold-dark: #df9d20;
        --dark: #17243a;
        --muted: #64748b;
        --ice: #edf5ff;
        --white: #fff;
        --card: #f8fbff;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: Arial, Helvetica, sans-serif;
        background: #f6f9ff;
        color: var(--dark);
        line-height: 1.6;
      }
      a { text-decoration: none; }
      img { max-width: 100%; display: block; }
      .container { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255,255,255,0.96);
        box-shadow: 0 2px 12px rgba(17,24,39,0.07);
        backdrop-filter: blur(8px);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 82px;
      }

      .logo img {
        width: 210px;
        height: auto;
      }

      nav {
        display: flex;
        gap: 24px;
        align-items: center;
      }

      nav a {
        color: var(--dark);
        font-weight: 700;
        font-size: 14px;
      }

      .btn {
        display: inline-block;
        background: var(--gold);
        color: var(--dark);
        font-weight: 800;
        padding: 14px 22px;
        border-radius: 8px;
        border: 2px solid transparent;
        cursor: pointer;
      }

      .btn.white {
        background: var(--white);
        color: var(--blue);
      }

      .btn.outline {
        background: transparent;
        color: var(--white);
        border-color: rgba(255,255,255,0.8);
      }

      .hero {
        background: linear-gradient(120deg, #103d7a, #1f5da9 48%, #2f79c5);
        color: var(--white);
        padding: 72px 0;
      }

      .hero-wrap {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 28px;
        align-items: center;
      }

      .eyebrow {
        display: inline-block;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        color: #eaf3ff;
        border-radius: 999px;
        padding: 8px 14px;
        margin-bottom: 18px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 12px;
      }

      h1 {
        font-size: clamp(2.4rem, 5vw, 4rem);
        line-height: 1.1;
        margin-bottom: 18px;
      }

      .hero p {
        color: rgba(255,255,255,0.9);
        font-size: 1.04rem;
        margin-bottom: 26px;
        max-width: 640px;
      }

      .feature-box {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 18px;
        padding: 24px;
        display: grid;
        gap: 16px;
      }

      .feature-box h3 {
        font-size: 1.1rem;
      }

      .feature-box ul {
        list-style: none;
        display: grid;
        gap: 10px;
      }

      .feature-box li {
        color: rgba(255,255,255,0.9);
      }

      .section {
        padding: 72px 0;
      }

      .section-heading {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 38px;
      }

      .section-heading h2 {
        font-size: clamp(2rem, 4vw, 2.7rem);
        color: var(--blue);
        margin-bottom: 10px;
      }

      .section-heading p {
        color: var(--muted);
      }

      .roles-grid, .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
      }

      .role-card, .info-card {
        background: var(--white);
        border-radius: 16px;
        padding: 24px 22px;
        border: 1px solid rgba(18,59,120,0.08);
        box-shadow: 0 10px 24px rgba(18,59,120,0.04);
      }

      .role-card h3, .info-card h3 {
        color: var(--blue);
        margin-bottom: 8px;
      }

      .role-card p, .info-card p {
        color: var(--muted);
      }

      .application-wrap {
        display: grid;
        grid-template-columns: 0.86fr 1.14fr;
        gap: 26px;
        align-items: start;
      }

      .apply-panel {
        background: var(--white);
        border: 1px solid rgba(18,59,120,0.08);
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 10px 24px rgba(18,59,120,0.04);
      }

      .apply-panel h3 {
        color: var(--blue);
        margin-bottom: 14px;
      }

      .apply-panel ul {
        list-style: none;
        display: grid;
        gap: 14px;
      }

      .apply-panel li {
        color: var(--dark);
        font-weight: 700;
      }

      form {
        display: grid;
        gap: 16px;
      }

      .field-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      input, textarea, select {
        width: 100%;
        border: 1px solid rgba(18,59,120,0.14);
        background: #f9fbff;
        border-radius: 10px;
        padding: 14px 16px;
        font: inherit;
        color: var(--dark);
      }

      textarea {
        min-height: 140px;
        resize: vertical;
      }

      .alert {
        display: none;
        padding: 14px 16px;
        border-radius: 10px;
        font-weight: 700;
      }

      .alert.success {
        display: block;
        background: #eafaf0;
        color: #166534;
        border: 1px solid #bbf7d0;
      }

      .alert.error {
        display: block;
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }

      footer {
        background: #0b2041;
        color: rgba(255,255,255,0.9);
        padding: 28px 0 36px;
      }

      .footer-box {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 18px;
      }

      @media (max-width: 900px) {
        .hero-wrap, .application-wrap { grid-template-columns: 1fr; }
        nav { display: none; }
      }

      @media (max-width: 700px) {
        .field-row { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <a href="/" class="logo" aria-label="A-Kwart Cleaning Expert Ltd home">
          <img src="logo.svg" alt="A-Kwart Cleaning Expert Ltd Logo" />
        </a>
        <nav>
          <a href="/">Home</a>
          <a href="/#about">About</a>
          <a href="/#services">Services</a>
          <a href="/#contact">Contact</a>
          <a href="/careers">Careers</a>
          <a class="btn" href="/#contact">Book Now</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-wrap">
          <div>
            <div class="eyebrow">Join our team</div>
            <h1>Work with a team that values reliability and excellence.</h1>
            <p>
              We’re looking for dedicated people who take pride in their work, care about detail,
              and want to help create spotless, welcoming spaces for homes and businesses across
